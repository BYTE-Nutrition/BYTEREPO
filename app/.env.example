# Copy to `.env.local`. Restart `npm run dev` after changes.

# API endpoints
# Local: paths match Vite proxy → realtime-proxy (or Netlify functions in production).
VITE_REALTIME_SESSION_URL=/realtime/session
# Meal-parse: default /meal-parse → realtime-proxy (OpenAI). For USDA on Render from localhost
# without CORS errors, use the USDA dev proxy (requires both lines; restart Vite after edits):
#   VITE_MEAL_PARSE_USDA_TARGET=https://byterepo.onrender.com
#   VITE_MEAL_PARSE_URL=/meal-parse-usda
# Production / Netlify: full URL is fine — set MEAL_PARSE_CORS_ORIGINS on Render to your Netlify origin.
# VITE_MEAL_PARSE_URL=https://byterepo.onrender.com/meal-parse
VITE_MEAL_PARSE_URL=/meal-parse

# Optional: "1" / "true" / "yes" = never use client-side FOODS fallback (voice review + add-ingredient use API only).
# VITE_MEAL_PARSE_STRICT=1

# Supabase — from https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog — from https://posthog.com → Project Settings → Project API key (optional)
VITE_POSTHOG_KEY=phc_your-key-here
# VITE_POSTHOG_HOST=https://us.i.posthog.com
