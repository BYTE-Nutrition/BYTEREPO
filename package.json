{
  "name": "byterepo",
  "private": true,
  "description": "Monorepo-style layout: install and run from app/, website/, or fifi-cursor-app/",
  "scripts": {
    "dev:app": "npm run dev --prefix app",
    "dev:website": "npm run dev --prefix website",
    "dev:fifi": "npm run dev --prefix fifi-cursor-app",
    "build:app": "npm run build --prefix app",
    "build:website": "npm run build --prefix website",
    "build:fifi": "npm run build --prefix fifi-cursor-app"
  },
  "dependencies": {
    "expo": "^55.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
}
