# This file is COMMITTED — keep only public defaults here (e.g. USDA DEMO_KEY).
# Put private keys in `.env` (gitignored); see `.env.example`.

# Used by `npm run meal-parse` in the app folder. Override with your own key for higher limits:
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY

# Optional overrides live in `.env` (not this file):
# OPENAI_API_KEY, MEAL_PARSE_OPENAI_MODEL
#
# Local dev: enables POST /meal-parse/debug (same JSON as /meal-parse). Override in .env with MEAL_PARSE_DEBUG=0 to turn off.
MEAL_PARSE_DEBUG=1
